#usda 1.0
(
    defaultPrim = "Faucet"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Faucet" (
    apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
    doc = "Original single-lever mixer. +Y is forward. yaw Z controls temperature; lift X controls flow. No liquid or heat solver."
)
{
    custom double faucet:coldSupplyC = 20
    custom double faucet:hotSupplyC = 60
    custom double faucet:maxFlowLpm = 6
    custom double faucet:targetOpening = 0
    custom double faucet:targetTemperatureC = 40
    custom bool physxArticulation:enabledSelfCollisions = 0
    custom int physxArticulation:solverPositionIterationCount = 32
    custom int physxArticulation:solverVelocityIterationCount = 8

    def "Looks"
    {
        def Material "Chrome"
        {
            token outputs:surface.connect = </Faucet/Looks/Chrome/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.65, 0.68, 0.72)
                float inputs:metallic = 1
                float inputs:roughness = 0.16
                token outputs:surface
            }
        }

        def Material "Aerator"
        {
            token outputs:surface.connect = </Faucet/Looks/Aerator/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.022, 0.025, 0.03)
                float inputs:metallic = 0.1
                float inputs:roughness = 0.38
                token outputs:surface
            }
        }

        def Material "Hot"
        {
            token outputs:surface.connect = </Faucet/Looks/Hot/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.7, 0.02, 0.015)
                float inputs:metallic = 0.05
                float inputs:roughness = 0.25
                token outputs:surface
            }
        }

        def Material "Cold"
        {
            token outputs:surface.connect = </Faucet/Looks/Cold/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.015, 0.12, 0.65)
                float inputs:metallic = 0.05
                float inputs:roughness = 0.25
                token outputs:surface
            }
        }
    }

    def Xform "body" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (0, 0.018, 0.083)
        float3 physics:diagonalInertia = (0.004, 0.004, 0.001)
        float physics:mass = 1.2
        quatf physics:principalAxes = (1, 0, 0, 0)

